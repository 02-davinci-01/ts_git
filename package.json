  "repository": {
    "type": "git",
    "url": "https://github.com/vedant-nagwanshi/ts-git"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "picocolors": "^1.1.1"
  }
}
