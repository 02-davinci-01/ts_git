  "description": "A Git implementation in TypeScript — supports init, add, commit, log, status, branching, checkout, and three-way merge",
  "main": "./dist/ts_git.js",
  "types": "./dist/ts_git.d.ts",
  "bin": {
    "ts-git": "./dist/cli.js"
  },
  "files": [
